<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header class="header">
        <h2><a href="/" style="text-decoration: none; color: inherit;">Admin Panel</a></h2>
        <nav class="navbar-nav">
            <% if (typeof user !=='undefined' && user && user._id) { %>
                <span class="user-greeting">Welcome, <%= user.firstname %></span>
                <a href="/admin/profile" class="nav-link">Profile</a>
                <a href="/logout" class="nav-link logout-btn">Logout</a>
                <% } else { %>
                    <a href="/" class="nav-link login-btn">Login</a>
                    <% } %>
        </nav>
    </header>
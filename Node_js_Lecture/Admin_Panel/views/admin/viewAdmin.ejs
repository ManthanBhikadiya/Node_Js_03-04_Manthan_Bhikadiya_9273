<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header', { title: 'View Admins' }) %>
    <%- include('../partials/sidebar') %>
        <main class="main">
            <div class="admin-container">
                <h2>Admin List</h2>
                <form action="/admin/view-admin" method="GET">
                    <input type="text" name="search" placeholder="Search by first or last name"
                        value="<%= typeof search !== 'undefined' ? search : '' %>">
                    <button type="submit">Search</button>
                </form>
                <% if (admin && admin.length> 0) { %>
                    <table>
                        <thead>
                            <tr>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Email</th>
                                <th>Mobile No.</th>
                                <th>Profile Image</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% admin.forEach(function(a) { %>
                                <tr>
                                    <td>
                                        <%= a.firstname %>
                                    </td>
                                    <td>
                                        <%= a.lastname %>
                                    </td>
                                    <td>
                                        <%= a.email %>
                                    </td>
                                    <td>
                                        <%= a.mobileno || 'N/A' %>
                                    </td>
                                    <td>
                                        <% if (a.profileimage) { %>
                                            <img src="<%= a.profileimage %>" alt="Profile" width="50" height="50">
                                            <% } else { %>
                                                No Image
                                                <% } %>
                                    </td>
                                    <td>
                                        <div class="actions-group">
                                            <a href="/admin/edit-admin/<%= a._id %>" class="btn-edit">Edit</a>
                                            <button class="btn-delete"
                                                onclick="if(confirm('Are you sure you want to delete this admin?')) { fetch('/admin/delete-admin/<%= a._id %>', { method: 'POST' }).then(() => window.location.reload()); }">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    <% } else { %>
                        <p>No admins found.</p>
                        <% } %>
            </div>
        </main>
        <%- include('../partials/footer') %>

</html>
<%- include('../partials/header', { title: 'Admin Dashboard' }) %>
    <%- include('../partials/sidebar') %>

        <main class="main">
            <h1>Welcome, <%= user.firstname %>
                    <%= user.lastname %></h1>

            <div class="stats-container">
                <div class="stat-card">
                    <h3>Total Admins</h3>
                    <p class="stat-number">
                        <%= stats.totalAdmins %>
                    </p>
                </div>
                <div class="stat-card">
                    <h3>Admins this week</h3>
                    <p class="stat-number">
                        <%= stats.adminsThisWeek %>
                    </p>
                </div>
                <div class="stat-card">
                    <h3>Your email</h3>
                    <p class="stat-number">
                        <%= user.email %>
                    </p>
                </div>
                <div class="stat-card">
                    <h3>Joined</h3>
                    <p class="stat-number">
                        <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'N/A' %>
                    </p>
                </div>
            </div>

            <div class="dashboard-content">
                <div class="card">
                    <h2>Recent Admins</h2>
                    <% if (recentAdmins && recentAdmins.length> 0) { %>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentAdmins.forEach((admin, index)=> { %>
                                    <tr>
                                        <td>
                                            <%= index + 1 %>
                                        </td>
                                        <td>
                                            <%= admin.firstname %>
                                                <%= admin.lastname %>
                                        </td>
                                        <td>
                                            <%= admin.email %>
                                        </td>
                                        <td>
                                            <%= admin.createdAt ? new Date(admin.createdAt).toLocaleDateString() : 'N/A'
                                                %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                        <% } else { %>
                            <p>No recent admin records available.</p>
                            <% } %>
                </div>
            </div>
        </main>

        <%- include('../partials/footer') %>